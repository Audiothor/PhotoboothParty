<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="#111111" 
             x:Class="PhotoboothParty.MainPage" 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Image x:Name="imgBackground" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="False" />
        
        <Grid HorizontalOptions="Center" RowDefinitions="Auto, Auto, Auto" VerticalOptions="Center" Margin="0,-120,0,0">
            <Label x:Name="lblLine1" FontAttributes="Bold" Grid.Row="0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label x:Name="lblLine2" Grid.Row="1" HorizontalOptions="Center" Margin="0,20,0,0" Opacity="0.8" HorizontalTextAlignment="Center" />
            <Label x:Name="lblLine3" Grid.Row="2" HorizontalOptions="Center" Margin="0,15,0,0" Opacity="0.8" HorizontalTextAlignment="Center" />
        </Grid>
        
        <!-- Bouton Paramètres flottant à l'extrême bord en haut à droite -->
        <ImageButton Source="settings_gear.png" 
                     Clicked="OnSettingsClicked" 
                     HorizontalOptions="End" 
                     VerticalOptions="Start" 
                     Margin="0,0,0,0" 
                     WidthRequest="44" 
                     HeightRequest="44" 
                     BackgroundColor="Transparent"
                     Padding="0" />
        
        <!-- Version au tout bas de l'ecran avec une marge securitaire pour la barre de navigation Android -->
        <Label x:Name="lblVersion" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,40" TextColor="Gray" FontSize="14" Opacity="0.5" />
    </Grid>
</ContentPage>
