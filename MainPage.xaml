<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="#111111" 
             x:Class="PhotoboothParty.MainPage" 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="settings_gear.png" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid HorizontalOptions="Center" RowDefinitions="Auto, Auto, Auto" VerticalOptions="Center">
            <Label x:Name="lblLine1" FontAttributes="Bold" Grid.Row="0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label x:Name="lblLine2" Grid.Row="1" HorizontalOptions="Center" Margin="0,20,0,0" Opacity="0.8" HorizontalTextAlignment="Center" />
            <!-- Ajout de la version juste en dessous pour être certain qu'elle ne soit pas cachée par la barre Android -->
            <Label x:Name="lblVersion" Grid.Row="2" HorizontalOptions="Center" Margin="0,80,0,0" TextColor="Gray" FontSize="14" Opacity="0.4" />
        </Grid>
    </Grid>
</ContentPage>
