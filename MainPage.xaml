<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="#111111" 
             x:Class="PhotoboothParty.MainPage" 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image x:Name="imgBackground" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="False" />
        
        <Grid HorizontalOptions="Center" RowDefinitions="Auto, Auto, Auto, Auto" VerticalOptions="Center" Margin="0,-120,0,0">
            <Label x:Name="lblLine1" FontAttributes="Bold" Grid.Row="0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label x:Name="lblLine2" Grid.Row="1" HorizontalOptions="Center" Margin="0,20,0,0" Opacity="0.8" HorizontalTextAlignment="Center" />
            <Label x:Name="lblLine3" Grid.Row="2" HorizontalOptions="Center" Margin="0,15,0,0" Opacity="0.8" HorizontalTextAlignment="Center" />
            <Label x:Name="lblLine4" Grid.Row="3" HorizontalOptions="Center" Margin="0,15,0,0" Opacity="0.7" HorizontalTextAlignment="Center" />
        </Grid>
        
        <!-- Bouton Paramètres flottant en bas à droite (avec marge de sécurité pour la navigation Android) -->
        <ImageButton Source="settings_gear.png" 
                     Clicked="OnSettingsClicked" 
                     HorizontalOptions="End" 
                     VerticalOptions="End" 
                     Margin="0,0,15,40" 
                     WidthRequest="44" 
                     HeightRequest="44" 
                     BackgroundColor="Transparent"
                     Padding="8" />
    </Grid>
</ContentPage>
