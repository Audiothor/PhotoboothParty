<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PhotoboothParty.SettingsPage"
             Title="Param&#xE8;tres"
             BackgroundColor="#111111">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <Label Text="Configuration" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" Margin="0,10,0,20"/>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="15" HasShadow="True" BorderColor="Transparent" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Test T&#xE9;l&#xE9;commande Bluetooth" TextColor="Silver" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Appuyez sur le bouton de votre t&#xE9;l&#xE9;commande." TextColor="Gray" FontSize="14" HorizontalTextAlignment="Center"/>
                    <Label x:Name="lblBluetoothTest" Text="En attente du signal..." TextColor="Orange" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="15" HasShadow="True" BorderColor="Transparent" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Titre - Ligne 1" TextColor="Silver" FontSize="16" FontAttributes="Bold" />
                    <Entry x:Name="entryLine1Text" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Texte (ex: Noces d'Argent)" HeightRequest="45"/>
                    <Grid ColumnDefinitions="*,*">
                        <Entry x:Name="entryLine1Color" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Couleur (ex: Silver)" Margin="0,0,5,0" HeightRequest="45"/>
                        <Entry x:Name="entryLine1Size" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Taille (ex: 36)" Grid.Column="1" Margin="5,0,0,0" HeightRequest="45"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Label Text="Sous-Titre - Ligne 2" TextColor="Silver" FontSize="16" FontAttributes="Bold" />
                    <Entry x:Name="entryLine2Text" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Texte" HeightRequest="45"/>
                    <Grid ColumnDefinitions="*,*">
                        <Entry x:Name="entryLine2Color" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Couleur (ex: White)" Margin="0,0,5,0" HeightRequest="45"/>
                        <Entry x:Name="entryLine2Size" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Taille (ex: 18)" Grid.Column="1" Margin="5,0,0,0" HeightRequest="45"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Label Text="Ligne 3" TextColor="Silver" FontSize="16" FontAttributes="Bold" />
                    <Entry x:Name="entryLine3Text" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Texte" HeightRequest="45"/>
                    <Grid ColumnDefinitions="*,*">
                        <Entry x:Name="entryLine3Color" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Couleur" Margin="0,0,5,0" HeightRequest="45"/>
                        <Entry x:Name="entryLine3Size" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="Taille" Grid.Column="1" Margin="5,0,0,0" HeightRequest="45"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="15" HasShadow="True" BorderColor="Transparent" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Compte &#xE0; rebours (secondes)" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="entryCaptureTimer" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" PlaceholderColor="Gray" HeightRequest="45"/>
                    
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Label Text="Dur&#xE9;e d'affichage (secondes)" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="entryPreviewDuration" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" PlaceholderColor="Gray" HeightRequest="45"/>
                    
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Label Text="Retour auto si inactif (secondes)" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="entryInactivityTimeout" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" PlaceholderColor="Gray" HeightRequest="45"/>
                    
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Bruit de l'appareil photo" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Switch x:Name="switchPlaySound" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Effet flash visuel" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Switch x:Name="switchPlayFlash" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Garder l'&#xE9;cran toujours allum&#xE9;" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Switch x:Name="switchKeepScreenOn" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="15" HasShadow="True" BorderColor="Transparent" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Utiliser la galerie par d&#xE9;faut" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Switch x:Name="switchUseDefaultGallery" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center" Toggled="OnDefaultGalleryToggled"/>
                    </Grid>

                    <VerticalStackLayout x:Name="layoutCustomFolder" Spacing="10" IsVisible="False">
                        <Button Text="S&#xE9;lectionner un dossier..." Clicked="OnSelectFolderClicked" BackgroundColor="#2D2D2D" TextColor="White" CornerRadius="10"/>
                        <Label x:Name="lblCustomFolderPath" Text="Aucun dossier s&#xE9;lectionn&#xE9;" TextColor="Gray" FontSize="12" LineBreakMode="CharacterWrap"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Text="Annuler" Clicked="OnCancelClicked" 
                        BackgroundColor="#333333" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="25" HeightRequest="55" FontSize="16"/>
                <Button Text="Enregistrer" Clicked="OnSaveClicked" Grid.Column="1"
                        BackgroundColor="#007ACC" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="25" HeightRequest="55" FontSize="16"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
