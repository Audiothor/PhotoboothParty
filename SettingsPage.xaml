<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PhotoboothParty.Resources.Strings"
             x:Class="PhotoboothParty.SettingsPage"
             Title="Param&#xE8;tres"
             BackgroundColor="#111111">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <Label Text="{x:Static strings:AppResources.SettingsTitle}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" Margin="0,0,0,20" />

            <Frame BackgroundColor="#1E1E1E" CornerRadius="15" HasShadow="True" BorderColor="Transparent" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Test T&#xE9;l&#xE9;commande Bluetooth" TextColor="Silver" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Appuyez sur le bouton de votre t&#xE9;l&#xE9;commande." TextColor="Gray" FontSize="14" HorizontalTextAlignment="Center"/>
                    <Label x:Name="lblBluetoothTest" Text="En attente du signal..." TextColor="Orange" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="15" BorderColor="#333333" Margin="0,0,0,15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static strings:AppResources.SettingsHomeScreen}" TextColor="Silver" FontSize="16" FontAttributes="Bold" Margin="0,0,0,5" />
                    
                    <!-- LIGNE 1 -->
                    <Label Text="{x:Static strings:AppResources.SettingsLine1}" TextColor="Silver" FontSize="16" FontAttributes="Bold" />
                    <Entry x:Name="entryLine1Text" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="{x:Static strings:AppResources.SettingsText}" HeightRequest="45"/>
                    
                    <Label Text="{x:Static strings:AppResources.SettingsLine1ColorLabel}" TextColor="Gray" FontSize="13" Margin="0,2,0,0" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="45">
                        <HorizontalStackLayout x:Name="stackLine1Colors" Spacing="8" Padding="2,0" VerticalOptions="Center" />
                    </ScrollView>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                        <Label Text="{x:Static strings:AppResources.SettingsLine1SizeLabel}" TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="lblLine1Size" Text="36 px" TextColor="White" FontSize="13" FontAttributes="Bold" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                    <Slider x:Name="sliderLine1Size" Minimum="12" Maximum="80" Value="36" MinimumTrackColor="#007ACC" MaximumTrackColor="#333333" ThumbColor="#007ACC" ValueChanged="OnLine1SizeChanged" Margin="0,0,0,10" />

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

                    <!-- LIGNE 2 -->
                    <Label Text="{x:Static strings:AppResources.SettingsLine2}" TextColor="Silver" FontSize="16" FontAttributes="Bold" />
                    <Entry x:Name="entryLine2Text" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="{x:Static strings:AppResources.SettingsText}" HeightRequest="45"/>
                    
                    <Label Text="{x:Static strings:AppResources.SettingsLine2ColorLabel}" TextColor="Gray" FontSize="13" Margin="0,2,0,0" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="45">
                        <HorizontalStackLayout x:Name="stackLine2Colors" Spacing="8" Padding="2,0" VerticalOptions="Center" />
                    </ScrollView>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                        <Label Text="{x:Static strings:AppResources.SettingsLine2SizeLabel}" TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="lblLine2Size" Text="18 px" TextColor="White" FontSize="13" FontAttributes="Bold" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                    <Slider x:Name="sliderLine2Size" Minimum="10" Maximum="60" Value="18" MinimumTrackColor="#007ACC" MaximumTrackColor="#333333" ThumbColor="#007ACC" ValueChanged="OnLine2SizeChanged" Margin="0,0,0,10" />

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

                    <!-- LIGNE 3 -->
                    <Label Text="{x:Static strings:AppResources.SettingsLine3}" TextColor="Silver" FontSize="16" FontAttributes="Bold" />
                    <Entry x:Name="entryLine3Text" TextColor="White" BackgroundColor="#2D2D2D" Placeholder="{x:Static strings:AppResources.SettingsText}" HeightRequest="45"/>
                    
                    <Label Text="{x:Static strings:AppResources.SettingsLine3ColorLabel}" TextColor="Gray" FontSize="13" Margin="0,2,0,0" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="45">
                        <HorizontalStackLayout x:Name="stackLine3Colors" Spacing="8" Padding="2,0" VerticalOptions="Center" />
                    </ScrollView>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                        <Label Text="{x:Static strings:AppResources.SettingsLine3SizeLabel}" TextColor="Gray" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="lblLine3Size" Text="16 px" TextColor="White" FontSize="13" FontAttributes="Bold" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                    <Slider x:Name="sliderLine3Size" Minimum="10" Maximum="60" Value="16" MinimumTrackColor="#007ACC" MaximumTrackColor="#333333" ThumbColor="#007ACC" ValueChanged="OnLine3SizeChanged" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="15" HasShadow="True" BorderColor="Transparent" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Compte &#xE0; rebours (secondes)" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="entryCaptureTimer" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" PlaceholderColor="Gray" HeightRequest="45"/>
                    
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Label Text="Dur&#xE9;e d'affichage (secondes)" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="entryPreviewDuration" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" PlaceholderColor="Gray" HeightRequest="45"/>
                    
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Label Text="Retour auto si inactif (secondes)" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                    <Entry x:Name="entryInactivityTimeout" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D2D" PlaceholderColor="Gray" HeightRequest="45"/>
                    
                    <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                    <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="15" BorderColor="#333333">
                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{x:Static strings:AppResources.SettingsCameraSound}" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch x:Name="switchPlaySound" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{x:Static strings:AppResources.SettingsFlashEffect}" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch x:Name="switchPlayFlash" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                            <VerticalStackLayout Spacing="5">
                                <Label Text="{x:Static strings:AppResources.SettingsHardwareFlash}" TextColor="Silver" FontSize="15" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5">
                                    <Button x:Name="btnFlashAuto" Text="Auto" BackgroundColor="#2D2D2D" TextColor="Silver" Clicked="OnFlashModeClicked" CommandParameter="Auto" CornerRadius="8" HeightRequest="40" Padding="0"/>
                                    <Button x:Name="btnFlashOn" Text="Forcé" BackgroundColor="#2D2D2D" TextColor="Silver" Grid.Column="1" Clicked="OnFlashModeClicked" CommandParameter="On" CornerRadius="8" HeightRequest="40" Padding="0"/>
                                    <Button x:Name="btnFlashOff" Text="Désactivé" BackgroundColor="#2D2D2D" TextColor="Silver" Grid.Column="2" Clicked="OnFlashModeClicked" CommandParameter="Off" CornerRadius="8" HeightRequest="40" Padding="0"/>
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{x:Static strings:AppResources.SettingsKeepScreenOn}" TextColor="Silver" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Switch x:Name="switchKeepScreenOn" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="15" BorderColor="#333333" Margin="0,0,0,15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static strings:AppResources.SettingsFolderSelection}" TextColor="Silver" FontSize="16" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static strings:AppResources.SettingsUseDefaultGallery}" TextColor="Silver" FontSize="15" VerticalOptions="Center"/>
                        <Switch x:Name="switchUseDefaultGallery" Grid.Column="1" OnColor="#007ACC" VerticalOptions="Center" Toggled="OnDefaultGalleryToggled"/>
                    </Grid>

                    <VerticalStackLayout x:Name="layoutCustomFolder" Spacing="5" IsVisible="False">
                        <Button Text="{x:Static strings:AppResources.SettingsSelectFolder}" BackgroundColor="#007ACC" TextColor="White" Clicked="OnSelectFolderClicked" HeightRequest="45" CornerRadius="8"/>
                        <Label x:Name="lblCustomFolderPath" Text="{x:Static strings:AppResources.SettingsFolder}" TextColor="Gray" FontSize="12" Margin="5,0,0,0" LineBreakMode="MiddleTruncation" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" Margin="0,20,0,0" ColumnSpacing="15">
                <Button Text="{x:Static strings:AppResources.SettingsCancel}" BackgroundColor="#555555" TextColor="White" Clicked="OnCancelClicked" CornerRadius="8" HeightRequest="50" Grid.Column="0"/>
                <Button Text="{x:Static strings:AppResources.SettingsSave}" BackgroundColor="#007ACC" TextColor="White" Clicked="OnSaveClicked" CornerRadius="8" HeightRequest="50" Grid.Column="1" FontAttributes="Bold"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
